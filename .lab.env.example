# Non-secret lab settings, one KEY=value per line. Copy this file to .lab.env.
# Keep comments on their own lines: the scripts read each KEY=value line literally.
# Secrets never go here. The scripts write them to .lab.secrets (mode 600).

# Input: the MCP service the agent app and the test client use (<catalog>.<schema>.<service>).
MCP_SERVICE_NAME=mcp_obo_lab.mcp.mcp_lab_mcp

# Written by infra/00_workspace.sh (set the user name placeholder in that script first).
WORKSPACE_HOST=
WORKSPACE_ID=
DATABRICKS_USERNAME=

# Written by infra/10_entra.sh (set the tenant ID placeholder in that script first).
TENANT_ID=
FRONTEND_CLIENT_ID=
BACKEND_CLIENT_ID=
MCP_API_CLIENT_ID=

# Written by infra/15_uc_conn_app.sh.
UC_CONN_CLIENT_ID=

# Written by infra/20_mcp_app.sh.
MCP_APP_NAME=
MCP_SERVER_URL=

# Written by infra/40_private_endpoint.sh.
NCC_ID=
PE_RULE_ID=

# Written by infra/spike_agw/51_appgw.sh, 52_acme_backend.sh and 56_atlassian_route.sh.
AGW_DNS_LABEL=
AGW_FQDN=
AGW_ACME_SA=
LAW_CUSTOMER_ID=

# Written by infra/60_agent_identity.sh and infra/61_agent_app.sh.
AGENT_SP_ID=
AGENT_APP_NAME=
AGENT_APP_URL=

# Written by infra/70_atlassian_client.sh.
ATLASSIAN_CLIENT_ID=
